@model List<Vista1Danielote.Models.PlanAdminModelo>
@{
    Layout = "~/Views/Shared/_LayoutAdminCabecera.cshtml";
    ViewData["Title"] = "Gestión de planes";
    ViewData["Subtitulo"] = "Planes";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="fw-bold text-white display-6 mb-1">Gestión de planes</h1><p class="text-secondary">Planes registrados en SQL Server</p></div>
    <a asp-action="Formulario" class="btn btn-netofit px-4 py-2"><i class="bi bi-plus-lg"></i> Nuevo plan</a>
</div>
@if (TempData["Error"] != null) { <p class="text-warning">@TempData["Error"]</p> }
<div class="bg-dark border border-secondary p-3 rounded-4"><div class="table-responsive"><table class="table table-dark table-hover align-middle mb-0">
    <thead><tr><th>NOMBRE</th><th>PRECIO</th><th>DURACIÓN</th><th>BENEFICIOS</th><th class="text-end">ACCIONES</th></tr></thead>
    <tbody>
    @foreach (var plan in Model)
    {
        <tr><td class="fw-bold text-white">@plan.Nombre</td><td>$@plan.Precio.ToString("0.00")</td><td>@plan.Duracion</td><td>@plan.Beneficios</td>
            <td class="text-end"><a asp-action="Formulario" asp-route-id="@plan.Id" class="text-light"><i class="bi bi-pencil"></i> Editar</a>
                <form asp-action="Eliminar" method="post" class="d-inline ms-3"><input type="hidden" name="id" value="@plan.Id" /><button type="submit" class="btn btn-link text-danger" onclick="return confirm('¿Eliminar este plan?')">Eliminar</button></form></td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-4">No hay planes registrados.</td></tr> }
    </tbody></table></div></div>
