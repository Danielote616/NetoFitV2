@model Vista1Danielote.Models.PlanAdminModelo
@{
    Layout = "~/Views/Shared/_LayoutAdminCabecera.cshtml";
    ViewData["Title"] = Model.Id == 0 ? "Nuevo plan" : "Editar plan";
    ViewData["Subtitulo"] = "Planes";
}
<div class="container py-4"><div class="bg-dark border border-secondary rounded-4 p-4 text-light">
    <h1 class="fw-bold fs-3 mb-4">@(Model.Id == 0 ? "Nuevo plan" : "Editar plan")</h1>
    <form asp-action="Formulario" method="post">
        <input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-warning"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Nombre">Nombre</label><input asp-for="Nombre" class="form-control bg-dark text-light border-secondary" required /></div>
            <div class="col-md-6"><label asp-for="Precio">Precio</label><input asp-for="Precio" type="number" step="0.01" min="0.01" class="form-control bg-dark text-light border-secondary" required /></div>
            <div class="col-md-6"><label asp-for="Duracion">Duración</label><input asp-for="Duracion" class="form-control bg-dark text-light border-secondary" /></div>
            <div class="col-12"><label asp-for="Beneficios">Beneficios separados por punto y coma</label><textarea asp-for="Beneficios" class="form-control bg-dark text-light border-secondary" rows="3"></textarea></div>
        </div>
        <div class="d-flex gap-3 mt-4"><button type="submit" class="btn btn-netofit px-4">Guardar plan</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
    </form>
</div></div>
