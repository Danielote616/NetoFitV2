@model List<Vista1Danielote.Models.SucursalAdminModelo>

@{
    ViewData["Title"] = "Inicio";
    ViewData["CSS"] = "~/css/estilo.css";
    ViewData["ClaseBody"] = "inicio-netofit";

    int? rol = Context.Session.GetInt32("Rol");

    List<Vista1Danielote.Models.PlanAdminModelo> planes =
        ViewBag.Planes as List<Vista1Danielote.Models.PlanAdminModelo>
        ?? new List<Vista1Danielote.Models.PlanAdminModelo>();
}

<section class="hero">
    <img src="~/images/hero.png" alt="Gimnasio" class="hero-imagen" />
    <div class="hero-overlay"></div>

    <div class="contenedor hero-texto">
        <span class="badge-lima">
            Nueva temporada · Inscripción abierta
        </span>

        <h1 class="hero-titulo">
            ENTRENA<br />SIN<br /><span class="texto-lima">LÍMITES.</span>
        </h1>

        <p class="hero-descripcion">
            Una membresía, todo El Salvador. Clases, entrenadores y equipo
            de primer nivel esperándote.
        </p>

        <div class="hero-botones">
            <a asp-controller="Home" asp-action="Planes"
               class="boton boton-lima">
                Ver planes →
            </a>

            <a asp-controller="Clases" asp-action="Index"
               class="boton boton-gris">
                Explorar clases
            </a>
        </div>

        <form asp-controller="Home" asp-action="Sucursales"
              method="get" class="hero-buscador">

            <input type="text" name="ciudad"
                   class="buscador-input"
                   placeholder="¿En qué ciudad quieres entrenar?" />

            <button type="submit" class="boton boton-blanco">
                Buscar sucursales
            </button>
        </form>
    </div>
</section>

<section class="contenedor seccion-sucursales">
    <div class="seccion-encabezado">
        <div>
            <h2>Sucursales destacadas</h2>
        </div>

        <a asp-controller="Home" asp-action="Sucursales"
           class="link-ver-todas">
            Ver todas →
        </a>
    </div>

    <div class="tarjetas-grid">

        @foreach (var sucursal in Model)
        {
            <div class="tarjeta-sucursal">

                @if (!string.IsNullOrWhiteSpace(sucursal.RutaImagen)
                            && sucursal.RutaImagen.StartsWith("~/Imagenes/Sucursales/"))
                {
                    <img src="@Url.Content(sucursal.RutaImagen)"
                         alt="Fotografía de @sucursal.Nombre"
                         loading="lazy" />
                }
                else
                {
                    <div style="height:180px;
                                        display:flex;
                                        align-items:center;
                                        justify-content:center;
                                        background:#252525;
                                        color:#cccccc;">
                        Imagen no disponible
                    </div>
                }

                <span class="etiqueta-ciudad">
                    @sucursal.Ciudad
                </span>

                <div class="tarjeta-texto">

                    <h3>@sucursal.Nombre</h3>

                    <p>@sucursal.Direccion</p>

                    <p>
                        @sucursal.Apertura.ToString(@"hh\:mm")
                        -
                        @sucursal.Cierre.ToString(@"hh\:mm")
                    </p>

                    <a asp-controller="Home"
                       asp-action="Sucursales">
                        Ver detalle →
                    </a>
                </div>
            </div>
        }

    </div>

    @if (Model.Count == 0)
    {
        <p>No hay sucursales registradas.</p>
    }
</section>

<section class="seccion-planes">
    <div class="contenedor">

        <div class="planes-encabezado">
            <span class="etiqueta">MEMBRESÍAS</span>
            <h2>Elige tu plan</h2>
            <p>Cancela cuando quieras. Sin letras chiquitas.</p>
        </div>

        <div class="planes-grid">

            @foreach (var plan in planes)
            {
                bool popular = plan.Nombre.Equals(
                "Pro",
                StringComparison.OrdinalIgnoreCase
                );

                <div class="tarjeta-plan @(popular ? "tarjeta-popular" : "")">

                    @if (popular)
                    {
                        <span class="badge-popular">
                            ★ MÁS POPULAR
                        </span>
                    }

                    <h3>@plan.Nombre</h3>

                    <p class="plan-descripcion">
                        @plan.Duracion
                    </p>

                    <p class="plan-precio">
                        $@plan.Precio.ToString("0.00")
                        <span>/@plan.Duracion.ToLowerInvariant()</span>
                    </p>

                    <ul>
                        @foreach (string beneficio in plan.Beneficios.Split(
                                            ';',
                                            StringSplitOptions.RemoveEmptyEntries |
                                            StringSplitOptions.TrimEntries))
                        {
                            <li>@beneficio</li>
                        }
                    </ul>

                    <a asp-controller="Home"
                       asp-action="Planes"
                       class="boton @(popular ? "boton-lima" : "boton-borde") boton-ancho">

                        Contratar @plan.Nombre

                    </a>

                </div>
            }

        </div>

        @if (planes.Count == 0)
        {
            <p style="text-align:center;">
                Por el momento no hay planes registrados.
            </p>
        }

    </div>
</section>

<section class="cta-banner">
    <div class="contenedor cta-interno">

        @if (rol == 2)
        {
            <p>♡ Continúa avanzando en tus objetivos.</p>

            <a asp-controller="Perfil"
               asp-action="Index"
               class="boton boton-blanco">
                Mi perfil
            </a>
        }
        else if (rol == 1)
        {
            <p>♡ Administra tu gimnasio desde un solo lugar.</p>

            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="boton boton-blanco">
                Ir al panel
            </a>
        }
        else
        {
            <p>♡ Tu primera semana es gratis. Empieza hoy.</p>

            <a asp-controller="Account"
               asp-action="Registro"
               class="boton boton-blanco">
                Comenzar ahora
            </a>
        }

    </div>
</section>
