@model Vistasdebeltran.Models.PerfilModelo

@{
    ViewData["Title"] = "Mi Perfil";
}

<style>
    .perfil-container {
        max-width: 800px;
        margin: 0 auto;
        font-family: 'Inter', sans-serif;
    }

    .perfil-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        background-color: #14171d;
        border: 1px solid #232730;
        border-radius: 16px;
        padding: 24px;
    }

    .avatar-circle {
        width: 72px;
        height: 72px;
        background-color: #1c2029;
        border: 2px solid #ccff00;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2em;
    }

    .perfil-name {
        font-size: 1.5em;
        font-weight: 700;
        color: #ffffff;
    }

    .perfil-email {
        color: #8a8f99;
        font-size: 0.9em;
        margin-top: 2px;
    }

    .badge-plan {
        display: inline-block;
        background-color: #132b1f;
        color: #22c55e;
        font-size: 0.8em;
        font-weight: 700;
        padding: 4px 12px;
        border-radius: 20px;
        margin-top: 8px;
    }

    .perfil-card {
        background-color: #14171d;
        border: 1px solid #232730;
        border-radius: 16px;
        padding: 24px 28px;
        margin-bottom: 24px;
    }

    .perfil-card-title {
        font-size: 1.1em;
        font-weight: 600;
        margin-bottom: 20px;
        color: #ffffff;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #1a1d24;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        color: #8a8f99;
        font-size: 0.9em;
    }

    .info-value {
        color: #ffffff;
        font-weight: 600;
        font-size: 0.9em;
    }

    .btn-edit {
        background-color: #1c2029;
        color: #ffffff;
        border: 1px solid #2a2f3d;
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 0.9em;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s;
    }

        .btn-edit:hover {
            background-color: #252b37;
        }
</style>

<div class="perfil-container">
    <div class="perfil-header">
        <div class="avatar-circle">👤</div>
        <div>
            <div class="perfil-name">@Model.Nombre</div>
            <div class="perfil-email">@Model.Correo</div>
            <span class="badge-plan">@Model.MembresiaActiva</span>
        </div>
    </div>

    <div class="perfil-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 class="perfil-card-title" style="margin: 0;">Información personal</h2>
            <button class="btn-edit">Editar perfil</button>
        </div>

        <div class="info-row">
            <span class="info-label">Nombre completo</span>
            <span class="info-value">@Model.Nombre</span>
        </div>
        <div class="info-row">
            <span class="info-label">Correo electrónico</span>
            <span class="info-value">@Model.Correo</span>
        </div>
        <div class="info-row">
            <span class="info-label">Teléfono</span>
            <span class="info-value">@Model.Telefono</span>
        </div>
        <div class="info-row">
            <span class="info-label">Sucursal principal</span>
            <span class="info-value">@Model.SucursalPrincipal</span>
        </div>
    </div>


    <div class="perfil-card">
        <h2 class="perfil-card-title">Detalles de la membresía</h2>

        <div class="info-row">
            <span class="info-label">Plan actual</span>
            <span class="info-value">@Model.MembresiaActiva</span>
        </div>
        <div class="info-row">
            <span class="info-label">Fecha de renovación</span>
            <span class="info-value">@Model.FechaRenovacion</span>
        </div>
        <div class="info-row">
            <span class="info-label">Estado</span>
            <span class="info-value" style="color: #22c55e;">Activa</span>
        </div>
    </div>
</div>