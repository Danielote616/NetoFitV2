@model Vistasdebeltran.Models.AdminPagosModelo

@{
    ViewData["Title"] = "Pagos y promociones";
}

<style>
    .admin-container {
        display: flex;
        flex-direction: row-reverse;
        gap: 30px;
        min-height: 80vh;
        margin-top: -10px;
    }

    .admin-main-content {
        flex: 1;
    }

    .admin-header-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 25px;
    }

    .btn-export {
        background-color: #14171d;
        color: #ffffff;
        border: 1px solid #2a2f3d;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.85em;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .admin-card {
        background-color: #14171d;
        border: 1px solid #232730;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 25px;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.88em;
    }

        .custom-table th {
            color: #585d68;
            font-weight: 600;
            font-size: 0.75em;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 12px 10px;
            border-bottom: 1px solid #232730;
        }

        .custom-table td {
            padding: 14px 10px;
            border-bottom: 1px solid #1a1d24;
            color: #ffffff;
        }

        .custom-table tr:last-child td {
            border-bottom: none;
        }

    .td-id {
        color: #8a8f99;
        font-size: 0.9em;
    }

    .td-client {
        font-weight: 600;
    }

    .td-monto {
        text-align: right;
        font-weight: 700;
    }

    .promo-card {
        background-color: #14171d;
        border: 1px solid #232730;
        border-radius: 12px;
        padding: 18px 20px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .promo-icon-box {
        background-color: #1c2029;
        width: 42px;
        height: 42px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ccff00;
        font-weight: bold;
        font-size: 1.1em;
    }

    .badge-activa {
        background-color: #132b1f;
        color: #22c55e;
        font-size: 0.75em;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
    }

    .badge-finalizada {
        background-color: #22252d;
        color: #8a8f99;
        font-size: 0.75em;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 20px;
    }

    .btn-nueva-promo {
        background-color: #ccff00;
        color: #000000;
        font-weight: 700;
        border: none;
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 0.85em;
        cursor: pointer;
    }
</style>

<div class="admin-container">

    <section class="admin-main-content">

        <div class="admin-header-row">

            <div>

                <span style="color:#8a8f99;font-size:0.8em;text-transform:uppercase;">
                    Administración
                </span>

                <h1 style="font-size:1.8em;font-weight:700;margin-top:2px;">
                    Pagos y promociones
                </h1>

                <p style="color:#8a8f99;font-size:0.9em;margin-top:4px;">
                    Transacciones recientes y campañas activas
                </p>

            </div>

            <a class="btn-export"
               asp-controller="AdminPagos"
               asp-action="Index"
               style="text-decoration:none;">
                Actualizar
            </a>

        </div>

        @if (TempData["Error"] != null)
        {
            <p role="alert"
               style="color:#ff7676;padding:12px;">
                @TempData["Error"]
            </p>
        }

        <div class="admin-card">

            <h3 style="font-size:1em;font-weight:600;margin-bottom:18px;">
                Pagos recientes
            </h3>

            <div style="overflow-x:auto;">

                <table class="custom-table">

                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">CLIENTE</th>
                            <th scope="col">MEMBRESÍA</th>
                            <th scope="col">MÉTODO</th>
                            <th scope="col">FECHA</th>
                            <th scope="col" style="text-align:right;">MONTO</th>
                            <th scope="col">ESTADO / ACCIÓN</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var pago in Model.PagosRecientes)
                        {
                            <tr>

                                <td class="td-id">
                                    @pago.Id
                                </td>

                                <td class="td-client">
                                    @pago.Cliente
                                </td>

                                <td style="color:#d0d5dd;">
                                    @pago.Membresia
                                </td>

                                <td style="color:#8a8f99;">
                                    @pago.Metodo
                                </td>

                                <td style="color:#8a8f99;">
                                    @pago.Fecha
                                </td>

                                <td class="td-monto">
                                    $@pago.Monto.ToString("0.00")
                                </td>

                                <td>

                                    @pago.Estado

                                    @if (pago.Estado == "Pendiente")
                                    {
                                        <form asp-controller="AdminPagos"
                                              asp-action="Confirmar"
                                              method="post"
                                              style="margin-top:5px;">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@pago.IdPago" />

                                            <button class="btn-nueva-promo"
                                                    type="submit">
                                                Confirmar pago recibido
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                        @if (Model.PagosRecientes.Count == 0)
                        {
                            <tr>
                                <td colspan="7">
                                    No hay pagos registrados.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <div>

            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">

                <h3 style="font-size:1em;font-weight:600;">
                    Promociones
                </h3>

                <a class="btn-nueva-promo"
                   asp-controller="AdminPagos"
                   asp-action="Promocion"
                   style="text-decoration:none;">
                    + Nueva
                </a>

            </div>

            @foreach (var promo in Model.PromocionesActivas)
            {
                <div class="promo-card">

                    <div style="display:flex;align-items:center;gap:16px;">

                        <div class="promo-icon-box">
                            %
                        </div>

                        <div>

                            <strong style="display:block;font-size:0.95em;">
                                @promo.Nombre
                            </strong>

                            <span style="color:#8a8f99;font-size:0.8em;">
                                @promo.PlanAplicable
                            </span>

                            <div style="color:#22c55e;font-weight:700;font-size:0.9em;margin-top:2px;">
                                @promo.Porcentaje
                            </div>

                        </div>

                    </div>

                    <div style="text-align:right;">

                        @if (promo.Estado == "Activa")
                        {
                            <span class="badge-activa">
                                ● Activa
                            </span>
                        }
                        else
                        {
                            <span class="badge-finalizada">
                                ● Finalizada
                            </span>
                        }

                        <div style="color:#8a8f99;font-size:0.8em;margin-top:8px;">
                            @promo.RangoFechas
                        </div>

                        <a asp-controller="AdminPagos"
                           asp-action="Promocion"
                           asp-route-id="@promo.Id"
                           style="color:#ccff00;text-decoration:none;font-size:0.8em;">
                            Editar
                        </a>

                        <form asp-controller="AdminPagos"
                              asp-action="EliminarPromocion"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@promo.Id" />

                            <button type="submit"
                                    class="btn-export"
                                    style="padding:4px 9px;font-size:0.75em;"
                                    onclick="return confirm('¿Eliminar promoción?')">
                                Eliminar
                            </button>

                        </form>

                    </div>

                </div>
            }

            @if (Model.PromocionesActivas.Count == 0)
            {
                <p style="color:#8a8f99;">
                    No hay promociones registradas.
                </p>
            }

        </div>

    </section>

</div>
