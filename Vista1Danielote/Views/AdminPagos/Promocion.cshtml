@model Vistasdebeltran.Models.PromocionAdminModelo

@{
    ViewData["Title"] = Model.Id == 0
        ? "Nueva promoción"
        : "Editar promoción";

    List<Vista1Danielote.Models.OpcionModelo> planes =
        (List<Vista1Danielote.Models.OpcionModelo>)ViewBag.Planes;
}

<div style="max-width:760px; margin:30px auto; padding:25px; border-radius:16px; background:#14171d; border:1px solid #232730; color:white;">

    <h1 style="font-size:1.7em; margin-bottom:22px;">
        @(Model.Id == 0 ? "Nueva promoción" : "Editar promoción")
    </h1>

    <form asp-controller="AdminPagos"
          asp-action="Promocion"
          method="post">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="All"
             style="color:#fca5a5; margin-bottom:12px;">
        </div>

        <div style="display:grid; gap:15px;">

            <div>
                <label asp-for="Nombre">Nombre</label>

                <input asp-for="Nombre"
                       required
                       class="form-control bg-dark text-light border-secondary" />
            </div>

            <div>
                <label asp-for="Descuento">Descuento (%)</label>

                <input asp-for="Descuento"
                       type="number"
                       step="0.01"
                       min="1"
                       max="100"
                       required
                       class="form-control bg-dark text-light border-secondary" />
            </div>

            <div>
                <label asp-for="IdPlan">Plan</label>

                <select asp-for="IdPlan"
                        class="form-select bg-dark text-light border-secondary"
                        required>

                    <option value="0">
                        Selecciona un plan
                    </option>

                    @foreach (var plan in planes)
                    {
                        <option value="@plan.Id">
                            @plan.Nombre
                        </option>
                    }

                </select>
            </div>

            <div>
                <label asp-for="FechaInicio">Inicio</label>

                <input asp-for="FechaInicio"
                       type="date"
                       class="form-control bg-dark text-light border-secondary" />
            </div>

            <div>
                <label asp-for="FechaFin">Fin</label>

                <input asp-for="FechaFin"
                       type="date"
                       class="form-control bg-dark text-light border-secondary" />
            </div>

        </div>

        <div style="display:flex; gap:15px; margin-top:25px;">

            <button type="submit" class="btn-nueva-promo">
                Guardar promoción
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

        </div>

    </form>

</div>
