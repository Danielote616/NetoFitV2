@model Vistasdebeltran.Models.PromocionAdminModelo

@{
    ViewData["Title"] = Model.Id == 0
        ? "Nueva promoción"
        : "Editar promoción";

    List<Vista1Danielote.Models.OpcionModelo> planes =
        (List<Vista1Danielote.Models.OpcionModelo>)ViewBag.Planes;
}

<style>
    .promo-formulario {
        max-width: 820px;
        margin: 20px auto 40px;
        padding: 0 15px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .promo-volver {
        display: inline-block;
        margin-bottom: 22px;
        color: #526172;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

        .promo-volver:hover {
            color: #477500;
            text-decoration: underline;
        }

    .promo-tarjeta {
        background: #ffffff;
        border: 1px solid #dbe8df;
        border-radius: 18px;
        padding: 32px;
        box-shadow: 0 5px 18px rgba(16, 24, 40, 0.04);
    }

    body.nf-cuerpo .nf-contenido-general .promo-formulario h1 {
        color: #12141a !important;
        font-size: 29px;
        font-weight: 700;
        line-height: 1.3;
        margin: 8px 0 10px;
    }

    .promo-etiqueta {
        display: inline-block;
        color: #537c00;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .promo-descripcion {
        color: #667085;
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 28px;
    }

    .promo-rejilla {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px;
    }

    .promo-campo {
        min-width: 0;
    }

    .promo-campo-completo {
        grid-column: 1 / -1;
    }

    .promo-campo label {
        display: block;
        margin-bottom: 9px;
        color: #27303a;
        font-size: 14px;
        font-weight: 700;
    }

    .promo-campo input,
    .promo-campo select {
        display: block;
        width: 100%;
        height: 46px;
        box-sizing: border-box;
        padding: 10px 13px;
        border: 1px solid #cbd8cf;
        border-radius: 10px;
        background: #ffffff;
        color: #12141a;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
    }

        .promo-campo input:focus,
        .promo-campo select:focus {
            outline: 2px solid #a7dd00;
            outline-offset: 1px;
            border-color: #85b600;
        }

    .promo-ayuda {
        display: block;
        margin-top: 7px;
        color: #667085;
        font-size: 12px;
        line-height: 1.5;
    }

    .promo-validacion {
        display: block;
        margin-top: 6px;
        color: #b42318;
        font-size: 12px;
    }

    .promo-resumen-validacion {
        color: #b42318;
        font-size: 13px;
        margin-bottom: 18px;
    }

        .promo-resumen-validacion:empty {
            display: none;
        }

    .promo-acciones {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid #e5ece7;
    }

    .promo-guardar,
    .promo-cancelar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 45px;
        box-sizing: border-box;
        padding: 11px 22px;
        border-radius: 10px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .promo-guardar {
        background: #c6ff00;
        border: 1px solid #c6ff00;
        color: #12141a;
    }

        .promo-guardar:hover {
            background: #b4e800;
            border-color: #b4e800;
            color: #12141a;
        }

    .promo-cancelar {
        background: #ffffff;
        border: 1px solid #cbd8cf;
        color: #344054;
    }

        .promo-cancelar:hover {
            background: #f0f6f1;
            color: #12141a;
        }

        .promo-guardar:focus-visible,
        .promo-cancelar:focus-visible,
        .promo-volver:focus-visible {
            outline: 3px solid #85b600;
            outline-offset: 3px;
        }

    @@media (max-width: 650px) {
        .promo-formulario {
            padding: 0 10px;
        }

        .promo-tarjeta {
            padding: 22px 18px;
        }

        .promo-rejilla {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        body.nf-cuerpo .nf-contenido-general .promo-formulario h1 {
            font-size: 25px;
        }

        .promo-acciones {
            flex-direction: column-reverse;
        }

        .promo-guardar,
        .promo-cancelar {
            width: 100%;
        }
    }

    html.nf-ac-oscuro body.nf-cuerpo .nf-contenido-general .promo-formulario h1 {
        color: #f0f4f8 !important;
    }

    html.nf-ac-oscuro body.nf-cuerpo .nf-contenido-general .promo-ayuda,
    html.nf-ac-oscuro body.nf-cuerpo .nf-contenido-general .promo-descripcion {
        color: #c3ced8;
    }

    html.nf-ac-oscuro body.nf-cuerpo .nf-contenido-general .promo-volver {
        color: #c6ff00;
    }

    html.nf-ac-oscuro body.nf-cuerpo .nf-contenido-general .promo-guardar {
        background: #c6ff00;
        border-color: #c6ff00;
        color: #12141a;
    }
</style>

<section class="promo-formulario">

    <a asp-controller="AdminPagos"
       asp-action="Index"
       class="promo-volver">
        ← Volver a pagos y promociones
    </a>

    <div class="promo-tarjeta">

        <span class="promo-etiqueta">
            Administración de promociones
        </span>

        <h1>
            @(Model.Id == 0
                        ? "Nueva promoción"
                        : "Editar promoción")
        </h1>

        <p class="promo-descripcion">
            Configura el descuento, el plan al que se aplicará
            y las fechas durante las cuales estará disponible.
        </p>

        <form asp-controller="AdminPagos"
              asp-action="Promocion"
              method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="All"
                 class="promo-resumen-validacion"
                 role="alert">
            </div>

            <div class="promo-rejilla">

                <div class="promo-campo promo-campo-completo">

                    <label asp-for="Nombre">
                        Nombre de la promoción
                    </label>

                    <input asp-for="Nombre"
                           type="text"
                           maxlength="100"
                           required />

                    <span asp-validation-for="Nombre"
                          class="promo-validacion">
                    </span>

                </div>

                <div class="promo-campo">

                    <label asp-for="Descuento">
                        Descuento (%)
                    </label>

                    <input asp-for="Descuento"
                           type="number"
                           min="1"
                           max="100"
                           step="0.01"
                           required />

                    <small class="promo-ayuda">
                        Ingresa un valor entre 1 y 100.
                    </small>

                    <span asp-validation-for="Descuento"
                          class="promo-validacion">
                    </span>

                </div>

                <div class="promo-campo">

                    <label asp-for="IdPlan">
                        Plan al que se aplica
                    </label>

                    <select asp-for="IdPlan" required>

                        <option value="0">
                            Selecciona un plan
                        </option>

                        @foreach (var plan in planes)
                        {
                            <option value="@plan.Id">
                                @plan.Nombre
                            </option>
                        }

                    </select>

                    <small class="promo-ayuda">
                        La promoción estará asociada a este plan.
                    </small>

                    <span asp-validation-for="IdPlan"
                          class="promo-validacion">
                    </span>

                </div>

                <div class="promo-campo">

                    <label asp-for="FechaInicio">
                        Fecha de inicio
                    </label>

                    <input asp-for="FechaInicio"
                           type="date"
                           required />

                    <span asp-validation-for="FechaInicio"
                          class="promo-validacion">
                    </span>

                </div>

                <div class="promo-campo">

                    <label asp-for="FechaFin">
                        Fecha de finalización
                    </label>

                    <input asp-for="FechaFin"
                           type="date"
                           required />

                    <span asp-validation-for="FechaFin"
                          class="promo-validacion">
                    </span>

                </div>

            </div>

            <div class="promo-acciones">

                <a asp-controller="AdminPagos"
                   asp-action="Index"
                   class="promo-cancelar">
                    Cancelar
                </a>

                <button type="submit"
                        class="promo-guardar btn-nueva-promo">

                    <i class="bi bi-check-circle"
                       aria-hidden="true"></i>

                    @(Model.Id == 0
                                        ? "Guardar promoción"
                                        : "Guardar cambios")

                </button>

            </div>

        </form>

    </div>

</section>
