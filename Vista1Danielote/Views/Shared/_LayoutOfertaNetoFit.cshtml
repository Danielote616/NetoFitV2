@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    if (ViewData["ClaseBody"] == null)
    {
        ViewData["ClaseBody"] = "oferta-body";
    }

    if (ViewData["AdminSeccion"] == null)
    {
        ViewData["AdminSeccion"] = "Clases";
    }
}

<div class="oferta-shell">
    <div class="oferta-principal">
        <main class="oferta-contenido" id="contenido-principal">
            @RenderBody()
        </main>
    </div>
</div>
