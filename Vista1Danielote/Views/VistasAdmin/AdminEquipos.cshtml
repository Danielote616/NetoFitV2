@model List<Vista1Danielote.Models.EquipoAdminModelo>
@{
    Layout = "~/Views/Shared/_LayoutAdminCabecera.cshtml";
    ViewData["Title"] = "Gestión de equipos";
    ViewData["Subtitulo"] = "Equipos";
    var sucursales = (List<Vista1Danielote.Models.SucursalAdminModelo>)ViewBag.Sucursales;
    int? filtro = ViewBag.FiltroSucursal;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="fw-bold text-white display-6 mb-1">Gestión de equipos</h1><p class="text-secondary mb-0">Inventario de equipo por sucursal</p></div>
    <a asp-controller="Admin" asp-action="FormularioEquipo" class="btn btn-netofit px-4 py-2 d-flex align-items-center gap-2"><i class="bi bi-plus-lg"></i> Registrar equipo</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="bg-dark border border-secondary p-4 rounded-4 d-flex justify-content-between align-items-center"><div><small class="text-secondary d-block mb-1">Operativo</small><h2 class="fw-bold text-success display-5 mb-0">@Model.Count(e => e.Estado == "Operativo")</h2></div><i class="bi bi-activity fs-1 text-secondary opacity-50"></i></div></div>
    <div class="col-md-4"><div class="bg-dark border border-secondary p-4 rounded-4 d-flex justify-content-between align-items-center"><div><small class="text-secondary d-block mb-1">Mantenimiento</small><h2 class="fw-bold text-warning display-5 mb-0">@Model.Count(e => e.Estado == "Mantenimiento")</h2></div><i class="bi bi-activity fs-1 text-secondary opacity-50"></i></div></div>
    <div class="col-md-4"><div class="bg-dark border border-secondary p-4 rounded-4 d-flex justify-content-between align-items-center"><div><small class="text-secondary d-block mb-1">Dañado</small><h2 class="fw-bold text-danger display-5 mb-0">@Model.Count(e => e.Estado == "Dañado")</h2></div><i class="bi bi-activity fs-1 text-secondary opacity-50"></i></div></div>
</div>
<div class="mb-4" style="max-width: 280px;"><form asp-action="Equipos" method="get"><select name="sucursal" class="form-select bg-dark text-light border-secondary py-2" onchange="this.form.submit()"><option value="">Todas las sucursales</option>@foreach (var s in sucursales) { if (filtro == s.Id) { <option value="@s.Id" selected>@s.Nombre</option> } else { <option value="@s.Id">@s.Nombre</option> } }</select></form></div>
<div class="bg-dark border border-secondary p-3 rounded-4"><div class="table-responsive"><table class="table table-dark table-hover align-middle mb-0">
    <thead><tr class="text-secondary border-bottom border-secondary" style="font-size: 0.8rem;"><th class="py-3">EQUIPO</th><th class="py-3">TIPO</th><th class="py-3">SUCURSAL</th><th class="py-3">CANTIDAD</th><th class="py-3">ESTADO</th><th class="py-3 text-end">ACCIONES</th></tr></thead>
    <tbody>
    @foreach (var equipo in Model) {
        <tr class="border-bottom border-secondary"><td class="py-3 fw-bold text-white">@equipo.Nombre</td><td class="text-secondary">@equipo.Tipo</td><td class="text-secondary">@equipo.Sucursal</td><td class="text-white fw-bold">1</td><td><span class="@(equipo.Estado == "Operativo" ? "badge-operativo" : equipo.Estado == "Mantenimiento" ? "badge-mantenimiento" : "badge-danado")">• @equipo.Estado</span></td><td class="text-end text-secondary"><a asp-action="FormularioEquipo" asp-route-id="@equipo.Id" class="text-light" title="Editar equipo"><i class="bi bi-pencil"></i></a> <form asp-action="EliminarEquipo" method="post" class="d-inline"><input type="hidden" name="id" value="@equipo.Id" /><button type="submit" class="btn btn-link text-danger p-0 ms-3" onclick="return confirm('¿Eliminar este equipo?')"><i class="bi bi-trash"></i></button></form></td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="6" class="text-center py-4">No se encontraron equipos.</td></tr> }
    </tbody></table></div></div>
