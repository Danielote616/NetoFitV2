@model Vista1Danielote.Models.DashboardAdminModelo
@using System.Globalization

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";

    ViewData["Title"] = "Dashboard";
    ViewData["Titulo"] = "Dashboard";

    decimal maximo = 1;
    int asistenciaTotal = 0;

    foreach (ReporteSucursalModelo sucursal in Model.Sucursales)
    {
        if (sucursal.Ingresos > maximo)
        {
            maximo = sucursal.Ingresos;
        }

        asistenciaTotal += sucursal.Asistencias;
    }

    int asistenciasGenerales = ViewBag.Asistencias;
    int asistenciasSinSucursal =
        asistenciasGenerales - asistenciaTotal;

    if (asistenciasSinSucursal < 0)
    {
        asistenciasSinSucursal = 0;
    }
    int? sucursalSeleccionada =
    (int?)ViewBag.SucursalSeleccionada;

    List<ReporteSucursalModelo> sucursalesFiltro =
        ViewBag.TodasLasSucursales as List<ReporteSucursalModelo>
        ?? new List<ReporteSucursalModelo>();
}

<div class="dashboard-encabezado">

    <div>
        <h2>Dashboard</h2>

        <p class="dashboard-subtitulo">
            Resumen del desempeño ·
            @DateTime.Today.ToString(
            "MMMM yyyy",
                        CultureInfo.GetCultureInfo("es-SV"))
        </p>
    </div>


    <form asp-controller="Admin"
          asp-action="Dashboard"
          method="get">

        <select name="sucursal"
                class="dashboard-select"
                aria-label="Seleccionar sucursal"
                onchange="this.form.submit()">

            <option value="">Todas las sucursales</option>

            @foreach (ReporteSucursalModelo sede in sucursalesFiltro)
            {
                if (sucursalSeleccionada == sede.IdSucursal)
                {
                    <option value="@sede.IdSucursal" selected="selected">
                        @sede.Nombre
                    </option>
                }
                else
                {
                    <option value="@sede.IdSucursal">
                        @sede.Nombre
                    </option>
                }
            }

        </select>

    </form>


</div>

<div class="tarjetas-stats">

    <div class="tarjeta-stat">
        <div class="stat-encabezado">
            <span class="stat-icono">$</span>
        </div>

        <p class="stat-numero">
            @(((decimal)ViewBag.Ingresos).ToString(
                        "C",
                        CultureInfo.GetCultureInfo("en-US")))
        </p>

        <p class="stat-etiqueta">
            @(sucursalSeleccionada.HasValue
                        ? "Clientes con membresía"
                        : "Clientes registrados")
        </p>
    </div>

    <div class="tarjeta-stat">
        <div class="stat-encabezado">
            <span class="stat-icono">●</span>
        </div>

        <p class="stat-numero">
            @ViewBag.Clientes
        </p>

        <p class="stat-etiqueta">
            Clientes registrados
        </p>
    </div>

    <div class="tarjeta-stat">
        <div class="stat-encabezado">
            <span class="stat-icono">✓</span>
        </div>

        <p class="stat-numero">
            @ViewBag.Asistencias
        </p>

        <p class="stat-etiqueta">
            Asistencias registradas
        </p>
    </div>

    <div class="tarjeta-stat">
        <div class="stat-encabezado">
            <span class="stat-icono">▣</span>
        </div>

        <p class="stat-numero">
            @ViewBag.PorVencer
        </p>

        <p class="stat-etiqueta">
            Membresías por vencer
        </p>
    </div>

</div>

<div class="panel-grafico">

    <div class="panel-encabezado">

        <h3>Ingresos por sucursal</h3>

        <span class="panel-nota">
            USD · pagos confirmados
        </span>

    </div>

    <div class="grafico-barras">

        @foreach (ReporteSucursalModelo sucursal in Model.Sucursales)
        {
            int altura = (int)(sucursal.Ingresos * 220 / maximo);

            if (altura < 4)
            {
                altura = 4;
            }

            <div class="barra-item">

                <div class="barra"
                     style="height:@(altura)px"
                     title="@sucursal.Ingresos.ToString("C", CultureInfo.GetCultureInfo("en-US"))">
                </div>

                <span>@sucursal.Nombre</span>

            </div>
        }

        @if (Model.Sucursales.Count == 0)
        {
            <p>No hay sucursales registradas.</p>
        }

    </div>

</div>

<div class="panel-asistencia">

    <h3>Asistencia por sucursal</h3>

    @foreach (ReporteSucursalModelo sucursal in Model.Sucursales)
    {
        int proporcion = 0;

        if (asistenciaTotal > 0)
        {
            proporcion = sucursal.Asistencias * 100 / asistenciaTotal;
        }

        <div class="progreso-fila">

            <span class="progreso-nombre">
                @sucursal.Nombre
            </span>

            <div class="progreso-barra">
                <div class="progreso-relleno"
                     style="width:@(proporcion)%">
                </div>
            </div>

            <span class="progreso-porcentaje">
                @sucursal.Asistencias
            </span>

        </div>
    }

    @if (Model.Sucursales.Count == 0)
    {
        <p>No hay sucursales registradas.</p>
    }

    @if (asistenciasSinSucursal > 0)
    {
        <p class="text-secondary"
           style="margin-top:15px;">

            @asistenciasSinSucursal asistencia(s) no pueden
            asociarse a una sucursal mediante una reserva.

        </p>
    }

</div>

<div class="panel-tabla">

    <div class="panel-encabezado">

        <h3>
            Membresías por vencer (próximos 15 días)
        </h3>

        <a asp-controller="Clientes"
           asp-action="Index">
            Ver todas
        </a>

    </div>

    <table class="tabla-membresias">

        <thead>
            <tr>
                <th scope="col">Cliente</th>
                <th scope="col">Plan</th>
                <th scope="col">Sucursal</th>
                <th scope="col">Vence</th>
                <th scope="col">Estado</th>
            </tr>
        </thead>

        <tbody>

            @foreach (ProximaMembresiaModelo membresia in Model.Proximas)
            {
                <tr>

                    <td class="celda-cliente">
                        @membresia.Cliente
                    </td>

                    <td>@membresia.Plan</td>

                    <td>@membresia.Sucursal</td>

                    <td>
                        @membresia.Fecha.ToString(
                        "dd MMM yyyy",
                                        CultureInfo.GetCultureInfo("es-SV"))
                </td>

                <td>
                    <span class="badge-estado ambar">
                        Por vencer
                    </span>
                </td>

            </tr>
                        }

            @if (Model.Proximas.Count == 0)
            {
                <tr>
                    <td colspan="5">
                        No hay membresías próximas a vencer.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>
