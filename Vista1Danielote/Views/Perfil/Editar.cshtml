@model Vista1Danielote.Models.ClienteFormularioAdminModelo
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ClaseBody"] = "netofit-body";
    ViewData["Title"] = "Editar mi perfil";
    ViewData["CSS"] = "~/css/ReservaNetoFit.css";
}
<main class="contenido-principal"><div class="perfil-contenedor">
    <nav class="ruta"><span>Mi perfil</span><span>›</span><span class="ruta-actual">Editar datos</span></nav>
    <section class="perfil-membresia" style="padding:25px;">
        <h1>Editar mis datos</h1>
        <form asp-controller="Perfil" asp-action="Editar" method="post">
            <div asp-validation-summary="All" style="color:#ef4444;"></div>
            <div class="perfil-membresia-datos" style="display:grid; gap:20px;">
                <div><label asp-for="Nombre">Nombre completo</label><input asp-for="Nombre" required style="display:block;width:100%;padding:12px;border-radius:8px;color:white;background:#1c2029;border:1px solid #2a2f3d;" /></div>
                <div><label asp-for="Correo">Correo electrónico</label><input asp-for="Correo" type="email" required style="display:block;width:100%;padding:12px;border-radius:8px;color:white;background:#1c2029;border:1px solid #2a2f3d;" /></div>
                <div><label asp-for="Telefono">Teléfono</label><input asp-for="Telefono" type="tel" pattern="[0-9]{8}" required style="display:block;width:100%;padding:12px;border-radius:8px;color:white;background:#1c2029;border:1px solid #2a2f3d;" /></div>
                <div><label asp-for="FechaNacimiento">Fecha de nacimiento</label><input asp-for="FechaNacimiento" type="date" required style="display:block;width:100%;padding:12px;border-radius:8px;color:white;background:#1c2029;border:1px solid #2a2f3d;" /></div>
                <div><label asp-for="Contrasena">Nueva contraseña (opcional)</label><input asp-for="Contrasena" type="password" style="display:block;width:100%;padding:12px;border-radius:8px;color:white;background:#1c2029;border:1px solid #2a2f3d;" /></div>
            </div>
            <div class="perfil-membresia-acciones" style="display:flex;gap:16px;margin-top:25px;">
                <button type="submit" class="perfil-renovar">Guardar cambios</button>
                <a asp-controller="Perfil" asp-action="Index" class="perfil-cambiar-plan">Cancelar</a>
            </div>
        </form>
    </section>
</div></main>
