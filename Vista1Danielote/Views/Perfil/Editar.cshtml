@model Vista1Danielote.Models.ClienteFormularioAdminModelo

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ClaseBody"] = "netofit-body";
    ViewData["Title"] = "Editar mi perfil";
    ViewData["CSS"] = "~/css/ReservaNetoFit.css";
}

<main class="contenido-principal">
    <div class="perfil-contenedor">

        <nav class="ruta">
            <span>Mi perfil</span>
            <span>›</span>
            <span class="ruta-actual">Editar datos</span>
        </nav>

        <section class="perfil-membresia perfil-editar-seccion">

            <h1>Editar mis datos</h1>

            <form asp-controller="Perfil"
                  asp-action="Editar"
                  method="post"
                  class="perfil-editar-formulario">

                <div asp-validation-summary="All"
                     class="perfil-aviso perfil-aviso-error">
                </div>

                <div class="perfil-membresia-datos perfil-editar-campos">

                    <div class="perfil-campo">
                        <label asp-for="Nombre">
                            Nombre completo
                        </label>
                        <input asp-for="Nombre"
                               required
                               class="perfil-formulario-control" />
                    </div>

                    <div class="perfil-campo">
                        <label asp-for="Correo">
                            Correo electrónico
                        </label>
                        <input asp-for="Correo"
                               type="email"
                               required
                               class="perfil-formulario-control" />
                    </div>

                    <div class="perfil-campo">
                        <label asp-for="Telefono">
                            Teléfono
                        </label>
                        <input asp-for="Telefono"
                               type="tel"
                               pattern="[0-9]{8}"
                               required
                               class="perfil-formulario-control" />
                    </div>

                    <div class="perfil-campo">
                        <label asp-for="FechaNacimiento">
                            Fecha de nacimiento
                        </label>
                        <input asp-for="FechaNacimiento"
                               type="date"
                               required
                               class="perfil-formulario-control" />
                    </div>

                    <div class="perfil-campo">
                        <label asp-for="Contrasena">
                            Nueva contraseña (opcional)
                        </label>
                        <input asp-for="Contrasena"
                               type="password"
                               class="perfil-formulario-control" />
                    </div>

                    <div class="perfil-campo">
                        <label asp-for="RutaImagen">
                            Foto de perfil (opcional)
                        </label>
                        <input asp-for="RutaImagen"
                               class="perfil-formulario-control" />

                        <span asp-validation-for="RutaImagen"
                              class="perfil-aviso perfil-aviso-error">
                        </span>
                    </div>

                </div>

                <div class="perfil-membresia-acciones perfil-editar-acciones">

                    <button type="submit" class="perfil-renovar">
                        Guardar cambios
                    </button>

                    <a asp-controller="Perfil"
                       asp-action="Index"
                       class="perfil-cambiar-plan">
                        Cancelar
                    </a>

                </div>

            </form>

        </section>

    </div>
</main>
