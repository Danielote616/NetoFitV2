@model List<ReservaModelo>
@using System.Globalization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ClaseBody"] = "netofit-body";
    ViewData["Title"] = "Mi perfil";
    ViewData["CSS"] = "~/css/ReservaNetoFit.css";

    string seccion = ViewBag.Seccion as string ?? "membresia";

    RutinaModelo? rutina = ViewBag.Rutina as RutinaModelo;

    EvaluacionModelo? evaluacion = ViewBag.Evaluacion as EvaluacionModelo;

    int idPlanActual = ViewBag.IdPlanActual ?? 0;
    bool solicitudPendiente = ViewBag.TieneSolicitudPendiente == true;
}

<main class="contenido-principal">
    <div class="perfil-contenedor">

        <nav class="ruta" aria-label="Ruta">
            <span>Inicio</span>
            <span>›</span>
            <span class="ruta-actual">Mi perfil</span>
        </nav>

        <section class="perfil-cabecera" aria-label="Datos de mi perfil">


            <div class="perfil-avatar" aria-hidden="true">
                @{
                    string rutaFoto = ViewBag.RutaImagen as string ?? "";
                }

                @if (!string.IsNullOrWhiteSpace(rutaFoto) &&
                                rutaFoto.StartsWith("~/Imagenes/Clientes/",
                                StringComparison.OrdinalIgnoreCase))
                {
                    <img src="@Url.Content(rutaFoto)" alt="" />
                }
                else
                {
                    <i class="bi bi-person-fill"></i>
                }
            </div>


            <div class="perfil-titular">
                <h1>@ViewBag.Usuario</h1>
                <p>@ViewBag.SubtituloMiembro</p>
            </div>

            <div class="perfil-contactos">
                <span>♙ &nbsp;@ViewBag.Correo</span>
                <span>⌖ &nbsp;@ViewBag.Sede</span>
            </div>

            <a class="perfil-editar"
               asp-controller="Perfil"
               asp-action="Editar">
                Editar datos
            </a>

        </section>

        <nav class="perfil-pestanas" aria-label="Secciones del perfil">

            <a asp-controller="Perfil"
               asp-action="Index"
               asp-route-seccion="membresia"
               class="@(seccion == "membresia" ? "perfil-pestana-activa" : "")"
               aria-current="@(seccion == "membresia" ? "page" : null)">
                Membresía
            </a>

            <a asp-controller="Perfil"
               asp-action="Index"
               asp-route-seccion="reservas"
               class="@(seccion == "reservas" ? "perfil-pestana-activa" : "")"
               aria-current="@(seccion == "reservas" ? "page" : null)">
                Reservas
            </a>

            <a asp-controller="Perfil"
               asp-action="Index"
               asp-route-seccion="rutina"
               class="@(seccion == "rutina" ? "perfil-pestana-activa" : "")"
               aria-current="@(seccion == "rutina" ? "page" : null)">
                Mi rutina
            </a>

            <a asp-controller="Perfil"
               asp-action="Index"
               asp-route-seccion="evaluaciones"
               class="@(seccion == "evaluaciones" ? "perfil-pestana-activa" : "")"
               aria-current="@(seccion == "evaluaciones" ? "page" : null)">
                Evaluaciones
            </a>

        </nav>

        @if (seccion == "membresia")
        {
            <section id="membresia"
                     class="perfil-membresia"
                     aria-label="Mi membresía">

                <div class="perfil-membresia-cuerpo">

                    <div class="perfil-membresia-superior">

                        <div>
                            <p class="perfil-membresia-etiqueta">
                                @ViewBag.EtiquetaMembresia
                            </p>

                            <h2>@ViewBag.Plan</h2>
                        </div>

                        <span class="perfil-membresia-estado">
                            ● @ViewBag.EstadoMembresia
                        </span>

                    </div>

                    <div class="perfil-membresia-datos">

                        <div>
                            <small>Vence el</small>
                            <strong>@ViewBag.Vence</strong>
                        </div>

                        <div>
                            <small>Sucursal base</small>
                            <strong>@ViewBag.SucursalBase</strong>
                        </div>

                        <div>
                            <small>Precio</small>
                            <strong>@ViewBag.Precio</strong>
                        </div>

                    </div>

                </div>

                @if (ViewBag.ProximoPlan != null)
                {
                    <p role="status" class="perfil-aviso perfil-aviso-exito perfil-aviso-membresia">
                        @ViewBag.ProximoPlan
                    </p>
                }

                <div class="perfil-membresia-acciones">

                    @if (solicitudPendiente)
                    {
                        <p role="status" class="perfil-aviso perfil-aviso-exito perfil-aviso-pendiente">
                            Tienes una solicitud de membresía pendiente.
                            Espera la confirmación del administrador
                            antes de realizar otra solicitud.
                        </p>
                    }
                    else if (idPlanActual > 0)
                    {
                        <a class="perfil-renovar"
                           asp-controller="Pago"
                           asp-action="Index"
                           asp-route-id="@idPlanActual"
                           asp-route-tipo="renovar">
                            Renovar ahora
                        </a>

                        <a class="perfil-cambiar-plan"
                           asp-controller="Home"
                           asp-action="Planes"
                           asp-route-tipo="cambiar">
                            Cambiar plan
                        </a>
                    }
                    else
                    {
                        <a class="perfil-renovar"
                           asp-controller="Home"
                           asp-action="Planes">
                            Elegir membresía
                        </a>
                    }

                </div>

            </section>
        }
        else if (seccion == "rutina")
        {
            <section id="rutina"
                     class="perfil-rutina"
                     aria-labelledby="perfil-rutina-titulo">

                @if (rutina != null)
                {
                    <div class="perfil-rutina-superior">

                        <div>
                            <p class="perfil-rutina-etiqueta">
                                OBJETIVO
                            </p>

                            <h2 id="perfil-rutina-titulo">
                                @rutina.Objetivo
                            </h2>
                        </div>

                        <p class="perfil-rutina-asignada">
                            Asignada por @rutina.Entrenador
                        </p>

                    </div>

                    <div class="perfil-rutina-tabla-marco"
                         role="region"
                         aria-label="Tabla de ejercicios de mi rutina"
                         tabindex="0">

                        <table class="perfil-rutina-tabla">

                            <thead>
                                <tr>
                                    <th scope="col">EJERCICIO</th>
                                    <th scope="col">SERIES</th>
                                    <th scope="col">REPS</th>
                                    <th scope="col">PESO</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (EjercicioRutinaModelo ejercicio in rutina.Ejercicios)
                                {
                                    <tr>
                                        <td>@ejercicio.Nombre</td>
                                        <td>@ejercicio.Series</td>
                                        <td>@ejercicio.Repeticiones</td>
                                        <td>@ejercicio.Peso</td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <h2 id="perfil-rutina-titulo">
                        Todavía no tienes una rutina asignada.
                    </h2>
                }

            </section>
        }
        else if (seccion == "evaluaciones")
        {
            <section id="evaluaciones"
                     class="perfil-evaluaciones"
                     aria-label="Mis evaluaciones físicas">

                @if (evaluacion != null && evaluacion.Historial.Count > 0)
                {
                    <div class="perfil-evaluaciones-indicadores">

                        <article class="perfil-evaluaciones-indicador">
                            <i class="bi bi-lightning-charge"
                               aria-hidden="true"></i>

                            <p>PESO ACTUAL</p>

                            <strong>
                                @evaluacion.PesoActual.ToString("0.#", CultureInfo.InvariantCulture) kg
                            </strong>

                            <span>
                                @evaluacion.CambioPeso.ToString("+0.#;-0.#;0", CultureInfo.InvariantCulture) kg desde la primera evaluación
                            </span>
                        </article>

                        <article class="perfil-evaluaciones-indicador">
                            <i class="bi bi-heart-pulse"
                               aria-hidden="true"></i>

                            <p>IMC</p>

                            <strong>
                                @evaluacion.ImcActual.ToString("0.#", CultureInfo.InvariantCulture)
                            </strong>

                            <span>
                                @evaluacion.CambioImc.ToString("+0.#;-0.#;0", CultureInfo.InvariantCulture) desde la primera evaluación
                            </span>
                        </article>

                        <article class="perfil-evaluaciones-indicador">
                            <i class="bi bi-droplet"
                               aria-hidden="true"></i>

                            <p>% GRASA</p>

                            <strong>
                                @evaluacion.GrasaActual.ToString("0.#", CultureInfo.InvariantCulture)%
                            </strong>

                            <span>
                                @evaluacion.CambioGrasa.ToString("+0.#;-0.#;0", CultureInfo.InvariantCulture)% desde la primera evaluación
                            </span>
                        </article>

                    </div>

                    <article class="perfil-evaluaciones-panel">

                        <h2>Progreso físico</h2>

                        <p>
                            Evolución de tus evaluaciones en @evaluacion.Anio
                        </p>

                        <div class="perfil-rutina-tabla-marco"
                             role="region"
                             aria-label="Historial de evaluaciones físicas"
                             tabindex="0">

                            <table class="perfil-rutina-tabla">

                                <thead>
                                    <tr>
                                        <th scope="col">MES</th>
                                        <th scope="col">PESO (KG)</th>
                                        <th scope="col">GRASA (%)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (RegistroEvaluacionModelo registro in evaluacion.Historial)
                                    {
                                        <tr>
                                            <td>@registro.Mes</td>
                                            <td>@registro.Peso.ToString("0.#", CultureInfo.InvariantCulture)</td>
                                            <td>@registro.Grasa.ToString("0.#", CultureInfo.InvariantCulture)</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>

                    </article>
                }
                else
                {
                    <div class="perfil-vacio">
                        <h2>
                            Todavía no tienes evaluaciones registradas.
                        </h2>
                    </div>
                }

            </section>
        }
        else
        {
            <section id="reservas"
                     class="perfil-listado"
                     aria-label="Mis reservas">

                @if (TempData["ErrorPerfil"] != null)
                {
                    <p role="alert" class="perfil-aviso perfil-aviso-error">
                        @TempData["ErrorPerfil"]
                    </p>
                }

                @if (TempData["ExitoPerfil"] != null)
                {
                    <p role="status" class="perfil-aviso perfil-aviso-exito">
                        @TempData["ExitoPerfil"]
                    </p>
                }

                @if (Model.Count == 0)
                {
                    <div class="perfil-vacio">

                        <h2>
                            Todavía no tienes reservas.
                        </h2>

                        <p>
                            Selecciona una clase para realizar una reserva.
                            Tus reservas confirmadas se guardan en el sistema.
                        </p>

                    </div>
                }
                else
                {
                    @foreach (ReservaModelo reserva in Model)
                    {
                        <article class="perfil-reserva">

                            <div>
                                <h2>@reserva.Clase.Nombre</h2>

                                <p>
                                    @reserva.Clase.Entrenador ·
                                    @reserva.Fecha.ToString("ddd dd MMM", CultureInfo.GetCultureInfo("es-SV")) ·
                                    @reserva.Clase.HoraTexto
                                </p>
                            </div>

                            <span class="perfil-estado">
                                ● @reserva.Estado
                            </span>

                            @if (reserva.Fecha.Date
                                            .Add(reserva.Clase.HoraInicio.TimeOfDay)
                                            .AddHours(-2) >= DateTime.Now)
                            {
                                <form asp-controller="Reserva"
                                      asp-action="Cancelar"
                                      asp-route-id="@reserva.IdReserva"
                                      method="post">

                                    <button type="submit"
                                            class="perfil-cancelar-reserva"
                                            onclick="return confirm('¿Quieres cancelar esta reserva?')">
                                        Cancelar reserva
                                    </button>

                                </form>
                            }

                        </article>
                    }
                }

                <a class="perfil-reservar-mas"
                   asp-controller="Clases"
                   asp-action="Index">
                    Reservar otra clase
                </a>

            </section>
        }

    </div>
</main>
